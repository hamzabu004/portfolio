# Postgres connection string (local Docker in dev, Neon in production)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/portfolio
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public URL of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 media storage (leave empty to store uploads on local disk)
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL (r2.dev or custom domain); files are then served directly from R2
MEDIA_PUBLIC_URL=
